<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nestedScrollViewHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="90dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Header Chips (Deals, Following, Saved) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDeals"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Deals 🔥"
                    android:textColor="#111111"
                    app:chipBackgroundColor="#F0F0F0"
                    app:chipCornerRadius="18dp"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFollowing"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Following"
                    android:textColor="#111111"
                    app:chipBackgroundColor="#F0F0F0"
                    app:chipCornerRadius="18dp"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSaved"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saved ❤️"
                    android:textColor="#111111"
                    app:chipBackgroundColor="#F0F0F0"
                    app:chipCornerRadius="18dp"
                    app:chipStrokeWidth="0dp" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Dark Card "Jump back in" -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardJumpBackIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="#111111"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jump back in"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <!-- Jump Card 1 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardJump1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#222222"
                        app:cardCornerRadius="12dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/imgJump1"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/ic_phone_store" />

                            <TextView
                                android:id="@+id/tvPriceJump1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                tools:text="29.990.000đ" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Jump Card 2 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardJump2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#222222"
                        app:cardCornerRadius="12dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/imgJump2"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/ic_phone_store" />

                            <TextView
                                android:id="@+id/tvPriceJump2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                tools:text="18.990.000đ" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Jump Card 3 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardJump3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#222222"
                        app:cardCornerRadius="12dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/imgJump3"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/ic_phone_store" />

                            <TextView
                                android:id="@+id/tvPriceJump3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                tools:text="15.490.000đ" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recently viewed Section -->
        <TextView
            android:id="@+id/tvRecentlyViewedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:text="Recently viewed"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- White Card "Recently viewed" Product Detail -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRecentlyViewed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRecentlyBrandLogo"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="#111111"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="A" />

                    <TextView
                        android:id="@+id/tvRecentlyBrandName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="#888888"
                        android:textSize="13sp"
                        tools:text="Apple" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgRecentlyProduct"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_phone_store" />

                <TextView
                    android:id="@+id/tvRecentlyProductName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#111111"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="iPhone 15 Pro Max" />

                <TextView
                    android:id="@+id/tvRecentlyProductPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#D32F2F"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="29.990.000 đ" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Category Sections Container (Apple, Samsung, Xiaomi, OPPO, Honor, ZTE) -->
        <LinearLayout
            android:id="@+id/layoutCategorySections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp" />

        <ProgressBar
            android:id="@+id/progressBarProducts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
