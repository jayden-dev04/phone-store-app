<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgAdminProduct"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Product Image"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_phone_store" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAdminProductBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#888888"
                android:textSize="12sp"
                tools:text="Apple" />

            <TextView
                android:id="@+id/tvAdminProductName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#111111"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="iPhone 15 Pro Max" />

            <TextView
                android:id="@+id/tvAdminProductPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#D32F2F"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="29.990.000 đ" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEditProduct"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Sửa sản phẩm"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="#1565C0" />

        <ImageButton
            android:id="@+id/btnDeleteProduct"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Xóa sản phẩm"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#D32F2F" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
